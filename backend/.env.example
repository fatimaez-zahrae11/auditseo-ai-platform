# Application
APP_NAME=AuditSEO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production example:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.production-domain.com
# FRONTEND_URL=https://production-domain.com
# CORS_ALLOWED_ORIGINS=https://production-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=auditseo
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Production PostgreSQL deployments should use the SSL mode required by the database provider.
# Example: DB_SSLMODE=require

# Cache / queue / Redis
CACHE_STORE=redis
CACHE_LIMITER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=300
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum bearer-token lifetime in minutes. This project reads SANCTUM_EXPIRATION.
SANCTUM_EXPIRATION=1440

# Framework storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
FILESYSTEM_DISK=local

# Local mail: verification messages are written to the Laravel log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"

# Resend production mail
RESEND_API_KEY=

# Production mail example :
# MAIL_MAILER=resend
# RESEND_API_KEY=<production-secret>
# MAIL_FROM_ADDRESS=no-reply@verified-production-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Production OAuth example:
# GOOGLE_REDIRECT_URI=https://api.production-domain.com/api/auth/google/callback
# FRONTEND_URL=https://production-domain.com
# APP_URL=https://api.production-domain.com

# AI recommendation provider
AI_PROVIDER=
AI_BASE_URL=
AI_ALLOWED_HOSTS=
AI_CHAT_ENDPOINT=/chat/completions
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RESPONSE_BYTES=1048576
AI_MAX_GENERATED_TEXT_CHARS=20000

# AI_ALLOWED_HOSTS must contain the hostname used by AI_BASE_URL.
# For multiple approved hosts, use a comma-separated list without schemes or paths.

# Audit queue health thresholds
HEALTH_STALE_PENDING_MINUTES=10
HEALTH_STALE_RUNNING_MINUTES=15
HEALTH_RECENT_FAILED_MINUTES=60

# Privacy, security telemetry, and failed-job retention
RETENTION_ACCESS_LOGS_DAYS=90
RETENTION_AUTH_AUDIT_LOGS_DAYS=365
RETENTION_API_USAGE_LOGS_DAYS=90
RETENTION_WEB_ANALYTICS_EVENTS_DAYS=365
RETENTION_ACTION_LOGS_DAYS=365
RETENTION_ADMIN_ACTION_LOGS_DAYS=365
RETENTION_IP_GEOLOCATIONS_DAYS=90
RETENTION_FAILED_JOBS_HOURS=720

# Optional local MaxMind GeoLite2 City database. Leave empty to disable lookups.
IP_GEOLOCATION_MAXMIND_DATABASE_PATH=
IP_GEOLOCATION_CACHE_DAYS=30
