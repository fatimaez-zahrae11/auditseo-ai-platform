APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_SSLMODE=require
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=auditseo_ai
# DB_USERNAME=postgres
# DB_PASSWORD=

# AI Provider - keys must stay empty here
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Production: use Redis for shared cache and Laravel rate limiting.
CACHE_STORE=redis
CACHE_LIMITER=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="AuditSEO AI Platform"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
AI_PROVIDER=dahl
AI_BASE_URL=https://inference.dahl.global/v1
AI_ALLOWED_HOSTS=inference.dahl.global
AI_CHAT_ENDPOINT=/chat/completions
AI_MODEL=moonshotai/Kimi-K2.6
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RESPONSE_BYTES=1048576
AI_MAX_GENERATED_TEXT_CHARS=20000
