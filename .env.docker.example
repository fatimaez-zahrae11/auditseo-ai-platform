# Copy this file to .env.docker. Keep the generated APP_KEY stable.

# Application
APP_NAME="AuditSEO AI Platform"
APP_SHORT_NAME="AuditSEO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Container logging
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL used by Laravel
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=auditseo
DB_USERNAME=auditseo
DB_PASSWORD=auditseo_local_password
DB_SSLMODE=prefer

# PostgreSQL image initialization (must match the DB_* values above)
POSTGRES_DB=auditseo
POSTGRES_USER=auditseo
POSTGRES_PASSWORD=auditseo_local_password

# Redis cache and queue
CACHE_STORE=redis
CACHE_LIMITER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=300
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum bearer-token lifetime in minutes
SANCTUM_EXPIRATION=1440

# Framework storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
FILESYSTEM_DISK=local

# Local mail is written to Docker logs
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Google OAuth (optional for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Public frontend configuration. VITE_* values are visible in the browser.
VITE_API_BASE_URL=http://localhost:8000/api

# AI recommendation provider (leave the complete group empty to disable it)
AI_PROVIDER=
AI_BASE_URL=
AI_ALLOWED_HOSTS=
AI_CHAT_ENDPOINT=/chat/completions
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RESPONSE_BYTES=1048576
AI_MAX_GENERATED_TEXT_CHARS=20000

# Audit queue health thresholds
HEALTH_STALE_PENDING_MINUTES=10
HEALTH_STALE_RUNNING_MINUTES=15
HEALTH_RECENT_FAILED_MINUTES=60

# Retention
RETENTION_ACCESS_LOGS_DAYS=90
RETENTION_AUTH_AUDIT_LOGS_DAYS=365
RETENTION_API_USAGE_LOGS_DAYS=90
RETENTION_WEB_ANALYTICS_EVENTS_DAYS=365
RETENTION_ACTION_LOGS_DAYS=365
RETENTION_ADMIN_ACTION_LOGS_DAYS=365
RETENTION_IP_GEOLOCATIONS_DAYS=90
RETENTION_FAILED_JOBS_HOURS=720

# Optional MaxMind GeoLite2 City database path inside the backend containers
IP_GEOLOCATION_MAXMIND_DATABASE_PATH=
IP_GEOLOCATION_CACHE_DAYS=30

